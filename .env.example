PORT=3001
KOI_APP_ORIGIN=http://localhost:5173
KOI_SUPABASE_URL=https://avqhjbrcbgqhelfkcist.supabase.co
KOI_SUPABASE_PUBLISHABLE_KEY=
# No configurar service_role: la API conserva los permisos del usuario (RLS).

# Opcional y solo en local: recuperar adjuntos recibidos mediante la API de Koi.
KOI_RELAY_CHAT_MEDIA=false

# Opcional: completar las cuatro variables juntas para habilitar WhatsApp.
# Solo backend; nunca usar prefijo VITE_ para estos valores.
# URL de Koi: https://evoapi.inmobiliarialyc.com.ar; instancia: koi-01.
EVOLUTION_PUBLIC_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
KOI_EVOLUTION_WORKSPACE_ID=

# API: recepción de estados de Evolution. Completar ambas juntas.
KOI_WEBHOOK_DATABASE_URL=
KOI_EVOLUTION_WEBHOOK_SECRET=
# Certificado raíz de Supabase, solo si la cadena no es reconocida por Node.
KOI_DATABASE_CA_FILE=

# Worker separado (Dockerfile.worker); no necesita la clave de Auth/Supabase API.
KOI_WORKER_DATABASE_URL=
KOI_SEND_ENABLED=false
KOI_WORKER_POLL_MS=3000

# Worker de chat: servicio independiente, sin cupos ni horarios de campaña.
# Dockerfile.worker: KOI_WORKER_KIND=chat. Campañas usa campaign (predeterminado).
KOI_WORKER_KIND=campaign
KOI_CHAT_WORKER_DATABASE_URL=
KOI_CHAT_SEND_ENABLED=false
# Opcional: conexión directa/Session Pooler para LISTEN; por defecto usa la de chat.
# No usar Transaction Pooler (6543). Si LISTEN falla, se recupera por polling de 1 s.
KOI_CHAT_LISTEN_DATABASE_URL=
