FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --chown=node:node src ./src
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD node -e "const fs=require('node:fs');try{process.exit(Date.now()-Number(fs.readFileSync('/tmp/koi-worker-heartbeat','utf8'))<60000?0:1)}catch{process.exit(1)}"
CMD ["node", "src/worker.ts"]
